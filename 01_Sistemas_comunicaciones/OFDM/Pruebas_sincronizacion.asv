clc;clear;close all;
% Pruebas del sincronizacoion
% Trabajamos solo con la señal de entrenamiento
%% Parametros

MQAM = 16;
N = 64;
Ncp = N/4;

Ni = 48;          % Portadoras de datos
Np = 4;           % Portadoras piloto
Nu = 12;          % Portadoras nulas
hcanal = [0.2 1 -0.2 0.5 0.1];
SNR= 100;
rng(10)

%% Indices OFDM

DC = N*0.5 + 1;
Nyquist = -32 + N*0.5 + 1;

indices_nulos = [-32;-31;-30;-29;-28;-27;0;27;28;29;30;31] + N*0.5 + 1;
indices_pilotos = [-21;-7;7;21] + N*0.5 + 1;
indice_datos = setdiff(1:N,[indices_pilotos;indices_nulos]);

%% Generacion del preambulo

[preT,Xpre_da,Xpre_pi] = ref_ofdm(N,2*Ncp,indices_nulos,indices_pilotos);

%------------Canal

Trama= [zeros(50,1); preT;zeros(50,1)];

n= 0: length(Trama)-1; n= n.';
CFO= 1/64 * 0.2;
Trama= Trama.* exp(1j*2*pi*n*CFO);

% ---------- Receptor

senyalRx= Trama;


% sincronizacion temporal

entre_inv = conj(preT(end:-1:1));

ss= filter(entre_inv,1,Trama);

[maximo,posicion]= max(abs(ss)); % 50+ 32+64+64 = 210 es l aultima posiciosn

senyal_preambulo = senyalRx(51:210);

%% busco el valor de  Z

entrenamiento= senyal_preambulo(33:end);
L= length(entrenamiento);
D= 64;

for k = 1: L

    
   Z= r(k)










function [preT,Xpre_da,Xpre_pi] = ref_ofdm(Nfft,Ncp,I_nu,I_pi)

rng(35)

Npi = length(I_pi);
Nda = Nfft - Npi - length(I_nu);

Xpre_da = randi([0 1],Nda,1)*2 - 1;
Xpre_pi = randi([0 1],Npi,1)*2 - 1;

ref = ofdmmod(Xpre_da,Nfft,Ncp,I_nu,I_pi,Xpre_pi);

preT = [ref; ref(end-Nfft+1:end)];

end